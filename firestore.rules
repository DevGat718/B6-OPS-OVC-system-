rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper validation functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 1. Issues Collection: Issue requests submitted by JFK Operations Coordinators
    match /issues/{irNumber} {
      // Allow read by all department coordinators and crew members
      allow read: if true;
      
      // Allow create and update with schema type validations
      allow create, update: if request.resource.data.irNumber is string
                            && isValidString(request.resource.data.title, 1, 300)
                            && request.resource.data.status in [
                                 'SUBMITTED', 'UNDER REVIEW', 'NEEDS INFORMATION',
                                 'VOTING', 'SUBMITTED TO LEADERSHIP', 'APPROVED', 
                                 'IMPLEMENTING', 'COMPLETED', 'BLOCKED', 
                                 'DENIED', 'ARCHIVED'
                               ];
      
      // Allow delete for database maintenance reset
      allow delete: if true;
    }

    // 2. Polls Collection: Coordinator voting proposals
    match /polls/{pollId} {
      allow read: if true;
      
      allow create, update: if request.resource.data.pollId is string
                            && isValidString(request.resource.data.title, 1, 300)
                            && request.resource.data.status in ['OPEN', 'CLOSED', 'ARCHIVED'];
                            
      allow delete: if true;
    }

    // 3. Votes Collection: Confidential coordinator ballots
    match /votes/{voteId} {
      allow read: if true;
      
      allow create: if request.resource.data.pollId is string
                    && isValidString(request.resource.data.id, 1, 50)
                    && request.resource.data.option in ['Option 1', 'Option 2', 'Option 3'];
                    
      allow update, delete: if true;
    }

    // 4. Meeting Notes Collection: VC committee meeting discussions linked to IRs
    match /meetingNotes/{noteId} {
      allow read, write: if true;
    }

    // 5. System Settings Collection: System configuration settings (such as sopChecklist)
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
